{
  "expo": {
    "name": "wren",
    "slug": "wren",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/wren.png",
    "scheme": "wren",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/wren.png"
    },
    "android": {
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "wren-nu.vercel.app"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/wren-rbg-white.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.nullvoid.wren",
      "softwareKeyboardLayoutMode": "resize",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/wren.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "android": {
            "image": "./assets/images/wren.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-background-task"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1bef8ec7-fc72-40b5-8bd7-f062ca6b2bb4"
      }
    },
    "owner": "ezet.galaxy"
  }
}